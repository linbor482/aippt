# 网页「API 密钥设置」写入的 config.json 优先于环境变量；环境变量作为兜底。
# 二者留空时 AI 大纲 / 视觉校验不可用（占位大纲与纯排版仍可用）。

# DeepSeek（AI 大纲 / 图片搜索词生成）
DEEPSEEK_API_KEY=

# 视觉匹配（可选，用于在联网配图候选里挑最贴合的一张）
VISION_API_KEY=
VISION_API_URL=https://api.siliconflow.cn/v1/chat/completions
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# 代理（可选，国内访问境外服务时设置，如 http://127.0.0.1:7890）
PROXY_URL=

# CORS 允许的来源（逗号分隔；部署时改成你的站点域名）
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 局域网共享时的访问口令（可选覆盖；留空则用首次打开页面时设置的账密 auth.json）
ACCESS_USERNAME=admin
ACCESS_PASSWORD=
